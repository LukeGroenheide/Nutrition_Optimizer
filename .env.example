# Optional messaging deployment only. Copy to .env, edit privately, and load
# into the service environment. This file is not read automatically by Python.
# Numbers below are illustrative configuration values, not personal targets.
NUTRITION_OPTIMIZER_DAILY_CALORIES_KCAL=2000
NUTRITION_OPTIMIZER_DAILY_PROTEIN_G=80
NUTRITION_OPTIMIZER_DAILY_CARBOHYDRATES_G=250
NUTRITION_OPTIMIZER_DAILY_FAT_G=70
NUTRITION_OPTIMIZER_DAILY_DIETARY_FIBER_MINIMUM_G=28

# Required for outbound BlueBubbles messages; set an actual private value.
NUTRITION_OPTIMIZER_BLUEBUBBLES_PASSWORD=replace-me
NUTRITION_OPTIMIZER_BLUEBUBBLES_CHAT_GUID=replace-me
# Optional: use when BlueBubbles is not at its local default.
# NUTRITION_OPTIMIZER_BLUEBUBBLES_URL=http://127.0.0.1:1234
# Optional alternative or additional inbound identity filter:
# NUTRITION_OPTIMIZER_BLUEBUBBLES_SENDER_ADDRESS=replace-me
# Optional override for the installed OpenClaw CLI:
# NUTRITION_OPTIMIZER_OPENCLAW_PATH=/path/to/openclaw
